# お問い合わせフォーム送信用（すべて任意。未設定の場合、フォームは「現在準備中」を返し何も送信しません）
# --- メール通知（Resend） ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@solutioncoop-jp.com
CONTACT_FROM_EMAIL=
# --- Google スプレッドシート記録（Apps Script Web アプリ URL） ---
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# 最新情報は lib/news.ts の静的データです。次の変数はもう読みません。
# Vercel に残っている値は消さなくて構いません。
# X_BEARER_TOKEN=
# X_USER_ID=
# X_USE_FIXTURE=
# X_REFRESH_SECRET=
