# Mẫu Nginx cho solutioncoop-web. CHƯA áp dụng lên máy chủ.
# Domain solutioncoop-jp.com chỉ là placeholder. Chưa chạy certbot từ repo này.
# Đặt nguyên file này trong http { } (ví dụ /etc/nginx/conf.d/solutioncoop.conf
# không được nếu map nằm ngoài server — file này gồm map + server, nên include
# từ nginx.conf trong khối http, không nhét vào trong một server có sẵn).

map $uri $solutioncoop_log_uri {
    /api/x/refresh $uri;
    default $request_uri;
}

log_format solutioncoop '$remote_addr - $remote_user [$time_local] '
    '"$request_method $solutioncoop_log_uri $server_protocol" '
    '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name solutioncoop-jp.com www.solutioncoop-jp.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name solutioncoop-jp.com www.solutioncoop-jp.com;

    # certbot --nginx sẽ tạo hoặc trỏ các file này. Chưa có chứng chỉ trong repo.
    ssl_certificate     /etc/letsencrypt/live/solutioncoop-jp.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/solutioncoop-jp.com/privkey.pem;

    access_log /var/log/nginx/solutioncoop.access.log solutioncoop;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
        add_header Cache-Control "no-cache";
    }
}
