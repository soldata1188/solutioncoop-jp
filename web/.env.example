# お問い合わせフォーム送信用（すべて任意。未設定の場合、フォームは「現在準備中」を返し何も送信しません）
# --- メール通知（Resend） ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@solutioncoop-jp.com
CONTACT_FROM_EMAIL=
# --- Google スプレッドシート記録（Apps Script Web アプリ URL） ---
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# --- 公式Xの投稿（サーバーだけが参照。値はコミットしない） ---
# X_BEARER_TOKEN=
# 任意。ユーザーID検索を省略するときだけ
# X_USER_ID=
# ローカルの見本表示だけ。Vercel 上では無視されます
# X_USE_FIXTURE=
# 手動更新リンクの合言葉。未設定のときは更新用URLは 404 を返します
# X_REFRESH_SECRET=
